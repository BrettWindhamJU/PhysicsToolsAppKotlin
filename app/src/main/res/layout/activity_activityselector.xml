<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/ju_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp" android:fitsSystemWindows="true">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Sensor studio" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/ju_green" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Explore the tools. These practice recordings are separate from student labs."
            android:paddingTop="12dp" android:paddingBottom="24dp" />
        <Button android:id="@+id/btnOpenAccelerometer" android:layout_width="match_parent" android:layout_height="64dp" android:text="Accelerometer · m/s²" />
        <Button android:id="@+id/btnOpenAccelerometerWithoutGravity" android:layout_width="match_parent" android:layout_height="64dp" android:text="Without gravity · m/s²" />
        <Button android:id="@+id/btnOpenMagnetometer" android:layout_width="match_parent" android:layout_height="64dp" android:text="Magnetometer · µT" />
        <Button android:id="@+id/btnOpenPressureSensor" android:layout_width="match_parent" android:layout_height="64dp" android:text="Pressure · hPa" />
        <Button android:id="@+id/btnSelectorHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Back to home" />
    </LinearLayout>
</ScrollView>
