<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button android:id="@+id/btnBackToSelector"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/back_to_selector" />

    <Button
        android:id="@+id/btnSensorRecord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/start_sensors_recording" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/workspace_card">
    <TextView android:id="@+id/xValue"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/x_empty" android:textSize="20sp" />
    <TextView android:id="@+id/yValue"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/y_empty" android:textSize="20sp" />
    <TextView android:id="@+id/zValue"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/z_empty" android:textSize="20sp" />
    <TextView android:id="@+id/recordingStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite" android:text="@string/recording_idle" />
    </LinearLayout>
    <Button android:id="@+id/btnViewData"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/view_saved_readings" />
    <Button android:id="@+id/btnBackRecordings"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/back_recordings" android:visibility="gone" />
    <Button android:id="@+id/btnAnalyze" android:backgroundTint="@color/ju_gold" android:textColor="@color/ju_text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/analyze_recording" android:visibility="gone" />
    <TextView android:id="@+id/historyHeading"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/recordings_heading" android:textStyle="bold" />
    <ListView android:id="@+id/recordingsList"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="@drawable/workspace_card" />
    <LinearLayout android:id="@+id/pageControls"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:visibility="gone">
        <Button android:id="@+id/btnPrevious"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/previous_page" />
        <Button android:id="@+id/btnNext"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/next_page" />
    </LinearLayout>
    <com.example.toolsappkotlin.LiveAccelerometerGraph
        android:id="@+id/accelerometerGraph"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />
</LinearLayout>


