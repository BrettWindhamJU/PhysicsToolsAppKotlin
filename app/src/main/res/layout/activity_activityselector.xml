<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <Button
        android:id="@+id/btnOpenAccelerometer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Go to Accelerometer"
        android:layout_marginBottom="0dp"
        app:layout_constraintWidth_percent="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnOpenAccelerometerWithoutGravity"
        app:layout_constraintVertical_chainStyle="spread" />

    <Button
        android:id="@+id/btnOpenAccelerometerWithoutGravity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Go to Accelerometer Without Gravity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnOpenAccelerometer"
        app:layout_constraintBottom_toTopOf="@id/btnOpenMagnetometer" />

    <Button
        android:id="@+id/btnOpenMagnetometer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Go to Magnetometer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnOpenAccelerometerWithoutGravity"
        app:layout_constraintBottom_toTopOf="@id/btnOpenPressureSensor" />

    <Button
        android:id="@+id/btnOpenPressureSensor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Go to Barometer (Pressure Sensor)"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnOpenMagnetometer"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
